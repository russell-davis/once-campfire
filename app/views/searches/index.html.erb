<% @page_title = "Search" %>
<% @body_class = "sidebar searches" %>

<% content_for :nav do %>
  <div class="slack-search-header">
    <div class="slack-search-header__row">
      <%= link_to room_path(@return_to_room), class: "slack-search-header__back" do %>
        <%= image_tag "arrow-left.svg", size: 16, aria: { hidden: "true" }, class: "colorize--black" %>
        <span class="for-screen-reader">Back to room</span>
      <% end %>

      <h1 class="slack-search-header__title overflow-ellipsis">
        <% if @query %>
          Results for “<%= @query %>” <span class="slack-search-header__count"><%= @messages.count %></span>
        <% else %>
          Search
        <% end %>
      </h1>
    </div>

    <%= form_with url: searches_path, class: "slack-search-header__form", role: "search" do |form| %>
      <%= image_tag "search.svg", size: 14, aria: { hidden: "true" }, class: "colorize--black" %>
      <%= form.search_field :q, value: @query, placeholder: "Search #{Current.account.name}", autocomplete: "off",
            required: true, aria: { label: "Search" } %>
    <% end %>

    <% if @recent_searches.any? %>
      <div class="slack-search-header__recents">
        <span class="slack-search-header__label">Recent</span>
        <% @recent_searches.each do |search| %>
          <%= link_to searches_path(q: search.query), class: "slack-search-chip" do %>
            <span class="overflow-ellipsis">“<%= search.query %>”</span>
          <% end %>
        <% end %>

        <%= button_to clear_searches_url, method: :delete, class: "slack-search-chip slack-search-chip--clear",
                data: { turbo_confirm: "Are you sure you want to clear your recent searches?" } do %>
          <%= image_tag "broom.svg", size: 14, aria: { hidden: "true" }, class: "colorize--black" %>
          <span class="for-screen-reader">Clear recent searches</span>
        <% end %>
      </div>
    <% elsif @query.blank? %>
      <p class="slack-search-header__hint">Type a word above to search messages in rooms you can see. Press / to jump to search.</p>
    <% end %>
  </div>
<% end %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<div id="message-area" class="message-area">
  <div class="message-area--empty min-width center">
    <figure class="center pad">
      <%= image_tag "search.svg", aria: { hidden: "true" }, class: "colorize--black translucent" %>
    </figure>
  </div>

  <%= search_results_tag do %>
    <%= render partial: "messages/message", collection: @messages, cached: true %>
  <% end %>
</div>
