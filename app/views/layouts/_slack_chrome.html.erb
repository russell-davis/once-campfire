<header id="slack-topbar">
  <%= form_with url: searches_path, class: "slack-topbar__search", role: "search",
        data: { controller: "slack-search", action: "keydown.esc->slack-search#blur" } do |form| %>
    <%= image_tag "search.svg", size: 14, aria: { hidden: "true" }, class: "colorize--black" %>
    <%= form.search_field :q, value: params[:q].presence, placeholder: "Search #{Current.account.name}", autocomplete: "off",
          required: true, aria: { label: "Search" }, data: { slack_search_target: "input" } %>
  <% end %>
</header>

<nav id="slack-rail" aria-label="Workspace">
  <%= link_to root_path, class: "slack-rail__logo", title: Current.account.name do %>
    <%= image_tag fresh_account_logo_path, size: 36, aria: { hidden: "true" } %>
    <span class="for-screen-reader"><%= Current.account.name %></span>
  <% end %>

  <%= link_to root_path, class: "slack-rail__item" do %>
    <span class="slack-rail__icon"><%= image_tag "messages.svg", size: 20, aria: { hidden: "true" }, class: "colorize--black" %></span>
    <span class="slack-rail__label">Home</span>
  <% end %>

  <%= link_to searches_path, class: "slack-rail__item" do %>
    <span class="slack-rail__icon"><%= image_tag "search.svg", size: 20, aria: { hidden: "true" }, class: "colorize--black" %></span>
    <span class="slack-rail__label">Search</span>
  <% end %>

  <div class="slack-rail__bottom">
    <%= link_to edit_account_path, class: "slack-rail__item" do %>
      <span class="slack-rail__icon"><%= image_tag "settings.svg", size: 20, aria: { hidden: "true" }, class: "colorize--black" %></span>
      <span class="for-screen-reader">Account Settings</span>
    <% end %>

    <%= link_to user_profile_path, class: "slack-rail__avatar" do %>
      <%= image_tag fresh_user_avatar_path(Current.user), size: 36, aria: { hidden: "true" } %>
      <span class="for-screen-reader">My Settings</span>
    <% end %>
  </div>
</nav>

<div id="slack-menu" data-controller="slack-menu" data-action="turbo:before-visit@document->slack-menu#close click@window->slack-menu#navigated">
  <button type="button" class="slack-menu__btn" data-slack-menu-target="button" data-action="slack-menu#toggle" aria-controls="sidebar" aria-expanded="false">
    <%= image_tag "menu.svg", size: 20, aria: { hidden: "true" }, class: "colorize--black" %>
    <span class="for-screen-reader">Open menu</span>
  </button>
  <div class="slack-menu__backdrop" data-action="click->slack-menu#close"></div>
</div>
